# =============================================================================
# Agentic-Labs — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# The test suite (tests/) uses this file to verify which keys are available
# and to skip tests that require missing keys gracefully.
# =============================================================================

# ---------------------------------------------------------------------------
# OpenAI  (used by most labs)
# ---------------------------------------------------------------------------
# Required by: lab010, lab020, lab032, lab035, lab040, lab050, lab054, lab060,
#              lab064, lab070, lab080, lab085, lab090, lab105, lab110, lab120,
#              lab990
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: override the base URL (e.g. for local proxy or Azure-compatible endpoint)
# Used by: lab050
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Google  (Gemini / ADK)
# ---------------------------------------------------------------------------
# Required by: lab061, lab110 (ADK server)
GOOGLE_API_KEY=your-google-api-key-here

# ---------------------------------------------------------------------------
# Azure OpenAI  (optional — addendum demos only)
# ---------------------------------------------------------------------------
# Required by: lab990 (ms-agent-framework demos)
# AZURE_OPENAI_API_KEY=your-azure-openai-key-here

# ---------------------------------------------------------------------------
# SerpAPI  (web search for agents)
# ---------------------------------------------------------------------------
# Required by: lab061, lab080 (CrewAI)
SERP_API_KEY=your-serpapi-key-here

# ---------------------------------------------------------------------------
# GitHub  (for RAG over repos)
# ---------------------------------------------------------------------------
# Required by: lab990 (llama_index rag_github demo)
# GITHUB_TOKEN=ghp_your-github-token-here

# ---------------------------------------------------------------------------
# Mem0  (managed memory service)
# ---------------------------------------------------------------------------
# Required by: lab087 (managed mode only — local mode needs no key)
# MEM0_API_KEY=your-mem0-api-key-here

# ---------------------------------------------------------------------------
# MCP Cloud  (remote MCP servers)
# ---------------------------------------------------------------------------
# Required by: lab070 (mcp_05 YouTube transcription)
# MCP_SSE_URL=https://your-mcp-sse-endpoint
# MCPCLOUD_API_TOKEN=your-mcpcloud-token-here
